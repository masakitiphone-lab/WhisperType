VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Cloudflare Worker URL that proxies audio to Groq for transcription.
VITE_TRANSCRIBE_URL=https://your-worker.your-subdomain.workers.dev

# App URLs used during OAuth callback handling.
VITE_APP_URL=http://localhost:1420
VITE_AUTH_REDIRECT_URL=https://studio-mirai.vercel.app/whispertype/redirect/

# Microsoft Store subscription add-on Store ID from Partner Center.
WHISPERTYPE_PLUS_STORE_ID=YOUR_PARTNER_CENTER_STORE_ID

# Comma-separated host allowlist used by the native app before it sends audio/token.
WHISPERTYPE_TRANSCRIBE_HOST_ALLOWLIST=your-worker.your-subdomain.workers.dev
