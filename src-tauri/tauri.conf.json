{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperType",
  "version": "0.1.0",
  "identifier": "com.whispertype.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "WhisperType",
        "width": 1100,
        "height": 760,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; img-src 'self' asset: data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* https://api.groq.com; media-src 'self' blob: data:; worker-src 'self' blob:;"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1QjVBRDMxNEZCNkMwQjgKUldTNHdMWlBNYTIxMVZZRENOS2ErT01UR3ErWGYydEFISFFaTzdjdHc4MjltRVFuaEpaU296U0cK---",
      "endpoints": [
        "https://github.com/masakitiphone-lab/WhisperType/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
