{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperType",
  "version": "0.1.0",
  "identifier": "com.whispertype.app",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhisperType",
        "width": 1040,
        "height": 780,
        "minWidth": 900,
        "minHeight": 680,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "WhisperType - Recording",
        "url": "overlay.html",
        "width": 360,
        "height": 170,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; img-src 'self' asset: data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://*.googleapis.com https://*.gstatic.com; media-src 'self' blob: data:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "whispertype"
        ]
      }
    }
  }
}
